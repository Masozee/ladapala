# .htaccess for Django Backend on cPanel
# For smkpariwisatamengwitani.com
# Place this file in your backend directory (e.g., public_html/api/)

# Enable Passenger for Python/Django
PassengerEnabled On
PassengerAppRoot /home/username/public_html/api/backend

# IMPORTANT: Update this path to match your Python virtual environment
# Example: /home/username/virtualenv/hotel_backend/bin/python3
PassengerPython /home/username/virtualenv/hotel_backend/bin/python3

# Set the WSGI startup file
PassengerStartupFile passenger_wsgi.py

# Python application type
PassengerAppType wsgi

# Environment (production)
SetEnv DJANGO_ENV production
SetEnv DJANGO_SETTINGS_MODULE core.settings

# URL Rewriting
RewriteEngine On
RewriteBase /api/

# Don't rewrite requests for existing files or directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route all other requests to the WSGI application
RewriteRule ^(.*)$ passenger_wsgi.py [QSA,L]

# Static files alias
# Update the path to match your actual directory structure
Alias /static /home/username/public_html/api/backend/staticfiles
Alias /media /home/username/public_html/api/backend/media

# Allow access to static files
<Directory /home/username/public_html/api/backend/staticfiles>
    Require all granted
    Options -Indexes +FollowSymLinks
    AllowOverride None
</Directory>

# Allow access to media files
<Directory /home/username/public_html/api/backend/media>
    Require all granted
    Options -Indexes +FollowSymLinks
    AllowOverride None
</Directory>

# Security: Deny access to sensitive files
<FilesMatch "^(\.env|\.git|db\.sqlite3|.*\.pyc|.*\.pyo|__pycache__)$">
    Require all denied
</FilesMatch>

# Disable directory browsing
Options -Indexes

# Enable compression for better performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/json application/javascript
</IfModule>

# Browser caching for static files
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# CORS Headers (if needed)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "https://smkpariwisatamengwitani.com"
    Header set Access-Control-Allow-Credentials "true"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "DNT,X-CustomHeader,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Authorization,X-CSRFToken"
</IfModule>
